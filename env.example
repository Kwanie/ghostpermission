# Required only for the optional AI-assisted review. Never commit your real .env file.
GROQ_API_KEY=your_groq_api_key_here

# Optional integration overrides; defaults match the supplied project files.
GHOST_PARSER_MODULE=core.manifest_parser
GHOST_PARSER_FUNCTION=extract_permissions
GHOST_MAPPER_MODULE=agents.permission_mapper
GHOST_MAPPER_OBJECT=permission_mapper_agent
GHOST_PURPOSE_MODULE=agents.purpose_analyst
GHOST_PURPOSE_OBJECT=purpose_analyst_agent
GHOST_COMBINATION_MODULE=agents.combination_analyst
GHOST_COMBINATION_OBJECT=combination_analyst_agent
GHOST_REVIEWER_MODULE=agents.skeptical_reviewer
GHOST_REVIEWER_OBJECT=skeptical_reviewer_agent
GHOST_KNOWLEDGE_BASE=data/permissions.json
